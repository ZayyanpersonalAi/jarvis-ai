# Jarvis AI — Environment keys / ماحول کی keys
# .env.local banayein: cp .env.local.example .env.local
# Phir apni keys dalein. Keys kabhi GitHub par mat dalein!

# Supabase (login + data) — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (asli Urdu voice + AI jawab) — https://platform.openai.com/api-keys
# Bina iske app Demo Mode mein chalta hai (Web Speech API + local replies).
OPENAI_API_KEY=sk-...

# Stripe (adaghiyan) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend (asli email) — https://resend.com/api-keys
RESEND_API_KEY=re_...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PC Agent (apne PC ko voice se control karne ke liye) — pc-agent/README dekhein
# Bina inke PC commands "PC Agent connected nahi hai" batayenge, chalenge nahi.
JARVIS_PC_URL=http://127.0.0.1:8787
JARVIS_PC_TOKEN=apna-pc-agent-token-yahan-dalein
